# Port (Render/Railway sets this automatically, default: 5000)
PORT=5000

# Environment
NODE_ENV=production

# MongoDB Atlas URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/inventory?retryWrites=true&w=majority

# JWT Secret & Expiry
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Allowed Frontend URLs for CORS (your Vercel app domain)
CLIENT_URL=https://your-frontend.vercel.app
ALLOWED_ORIGINS=https://your-frontend.vercel.app
